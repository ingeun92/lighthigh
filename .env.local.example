# lighthigh 환경변수 템플릿 — 이 파일을 .env.local 로 복사해 실제 값을 채우세요.
# .env.local 은 git 에 커밋되지 않습니다.

# --- 경기 일정/결과: football-data.org (무료 tier) ---
# https://www.football-data.org/client/register 에서 발급
FOOTBALL_DATA_TOKEN=

# --- 하이라이트 수집: YouTube Data API v3 ---
# https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → API 키
YOUTUBE_API_KEY=

# (선택) 라이브 스코어가 필요해지면 API-Football 로 전환
APIFOOTBALL_KEY=

# --- 관리자 페이지(/admin) 보호용 토큰 (미설정 시 로컬에서 인증 없이 접근) ---
ADMIN_TOKEN=

# --- Supabase (DB) — 프로젝트 생성 후 채움 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
